{
  "name": "catatin",
  "version": "1.0.0",
  "description": "Personal finance Telegram bot with mobile-friendly analytics dashboard",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/index.ts",
    "dev:web": "vite --config vite.config.ts",
    "dev": "tsx watch src/index.ts",
    "build:web": "vite build --config vite.config.ts",
    "build:server": "tsc",
    "build": "vite build --config vite.config.ts && tsc",
    "start": "node dist/index.js",
    "start:ts": "tsx src/index.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hono/node-server": "^1.13.8",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "grammy": "^1.35.0",
    "hono": "^4.7.2",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.1"
  }
}
