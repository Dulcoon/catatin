# ===================================================
# Catatin - Personal Finance Configuration
# ===================================================

# Port server (default unik: 7878)
PORT=7878

# Domain / URL HTTPS Publik (Wajib HTTPS untuk tombol Telegram Web App)
PUBLIC_URL=https://catatin.dulcoon-dev.web.id

# Keamanan Akun
# ID akun Telegram Anda (Dapatkan dari @userinfobot di Telegram)
ADMIN_TELEGRAM_ID=123456789
# Token Bot Telegram dari @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here
# PIN 4-6 digit untuk login web via browser biasa
DASHBOARD_PIN=1234

# Budgeting
# Target budget mingguan dalam rupiah (contoh: 500000)
WEEKLY_BUDGET=500000
# Persentase batas peringatan pertama (default: 80%)
WARNING_THRESHOLD_PERCENT=80

# AI Configuration (Primary: Google Gemini Flash)
# Dapatkan gratis di https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# AI Fallback (OpenAI-compatible endpoint / OpenRouter)
# Aktif otomatis jika kuota Gemini limit atau mengalami kendala
FALLBACK_AI_API_KEY=
FALLBACK_AI_BASE_URL=https://openrouter.ai/api/v1
FALLBACK_AI_MODEL=deepseek/deepseek-chat

# Database file path
DATABASE_PATH=catatin.db
